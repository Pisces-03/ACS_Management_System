# Laravel Framework
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
.env
.env.backup
.env.production
.phpunit.result.cache
Homestead.json
Homestead.yaml
auth.json
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.vscode

# Database
*.sqlite
*.sqlite3
*.db
database/*.sqlite

# Logs
/storage/logs/*.log
/storage/logs/*
!/storage/logs/.gitkeep

# Debug and Test Files (root folder only, so real app files are never skipped)
/reset*.php
/check*.php
/debug*.php
/test*.php
*.bak
*.tmp

# Keep local vendor assets for hosting
!/public/vendor/

# Cache
/bootstrap/cache/*
!/bootstrap/cache/.gitkeep
/storage/framework/cache/*
!/storage/framework/cache/.gitkeep
/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep
/storage/framework/views/*
!/storage/framework/views/.gitkeep

# Uploads
/storage/app/*
!/storage/app/.gitkeep
!/storage/app/public/
/storage/app/public/*
!/storage/app/public/.gitkeep

# Compiled assets
/public/js/app.js
/public/css/app.css
/public/mix-manifest.json

# Development files
*.bak
*.backup
*.tmp
/debug_*.php
/test_*.php
/temp_*.php

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~

# Package managers (keep composer.lock for production)
package-lock.json
yarn.lock

# Local database files (never commit data)
/database/*
!/database/migrations
!/database/seeders
!/database/factories
